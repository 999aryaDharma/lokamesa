<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Document IDE"
           Manufacturer="Document IDE"
           Version="1.0.0.0"
           UpgradeCode="C3B24F81-99A1-4E12-B8E5-77981A6498B1"
           Scope="perMachine">
    
    <MajorUpgrade DowngradeErrorMessage="A newer version of Document IDE is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- WebView2 Evergreen Prerequisite Search -->
    <Property Id="WEBVIEW2_EVERGREEN_INSTALLED">
      <RegistrySearch Id="SearchWebView2"
                      Root="HKLM"
                      Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
                      Name="pv"
                      Type="raw"
                      Bitness="always32" />
    </Property>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Document IDE">
        <Component Id="MainExecutable" Guid="84E1A2B5-5F8D-4E90-B8A7-33E980453C01">
          <File Id="DocumentIDE.Desktop.exe" Source="$(var.SourceDir)\DocumentIDE.Desktop.exe" KeyPath="yes" />
        </Component>

        <Component Id="ShareHostExecutable" Guid="92B3C4D5-6E7F-8A9B-0C1D-2E3F4A5B6C7D">
          <File Id="DocumentIDE.ShareHost.exe" Source="$(var.SourceDir)\DocumentIDE.ShareHost.exe" KeyPath="yes" />
        </Component>

        <Directory Id="WwwrootDir" Name="wwwroot">
          <Component Id="WwwrootFolder" Guid="A1B2C3D4-E5F6-7A8B-9C0D-1E2F3A4B5C6D">
            <CreateFolder />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="ApplicationShortcut" Guid="71B2C3D4-E5F6-4A5B-9C0D-1E2F3A4B5C6D">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="Document IDE"
                  Target="[INSTALLFOLDER]DocumentIDE.Desktop.exe"
                  Directory="ProgramMenuFolder" />
        <RegistryValue Root="HKCU" Key="Software\DocumentIDE" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Document IDE Application" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ShareHostExecutable" />
      <ComponentRef Id="WwwrootFolder" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Package>
</Wix>
