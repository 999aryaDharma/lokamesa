<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Document IDE"
           Manufacturer="Document IDE"
           Version="1.0.2.0"
           UpgradeCode="C3B24F81-99A1-4E12-B8E5-77981A6498B1"
           Scope="perUser">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Document IDE is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- WebView2 Evergreen Prerequisite Search -->
    <Property Id="WEBVIEW2_EVERGREEN_INSTALLED">
      <RegistrySearch Id="SearchWebView2"
                      Root="HKLM"
                      Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
                      Name="pv"
                      Type="raw"
                      Bitness="always32" />
    </Property>

    <!--
      Per-user install under %LOCALAPPDATA%\Programs\Document IDE: the local
      auto-updater swaps this directory without elevation. A per-machine
      1.0.0.0 install cannot be upgraded across installation contexts; see
      docs/releases/v1.0.2.md for the one-time migration.
    -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Document IDE" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="ApplicationShortcut" Guid="71B2C3D4-E5F6-4A5B-9C0D-1E2F3A4B5C6D">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="Document IDE"
                  Target="[INSTALLFOLDER]DocumentIDE.Desktop.exe"
                  Directory="ProgramMenuFolder" />
        <RegistryValue Root="HKCU" Key="Software\DocumentIDE" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!--
      The published desktop payload is a self-contained win-x64 deployment: the
      two executables (DocumentIDE.Desktop.exe and DocumentIDE.ShareHost.exe)
      cannot run without DocumentIDE.Api/Core/Infrastructure and the .NET runtime
      beside them. This group harvests the whole publish output, including the
      wwwroot web assets, so the installed app is complete. A test asserts the MSI
      File table actually contains the runtime assemblies and the web assets; an
      existence-only check is what let a 0.31 MB installer pass before.
    -->
    <ComponentGroup Id="PayloadFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.SourceDir)\**" />
    </ComponentGroup>

    <Feature Id="MainFeature" Title="Document IDE Application" Level="1">
      <ComponentGroupRef Id="PayloadFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Package>
</Wix>
